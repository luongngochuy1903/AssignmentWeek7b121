<?xml version="1.0" encoding="UTF-8"?>
<Context>
  <Resource
      name="jdbc/murach"
      auth="Container"
      type="javax.sql.DataSource"
      maxTotal="20"
      maxIdle="5"
      maxWaitMillis="10000"
      username="${DB_USER}"
      password="${DB_PASSWORD}"
      driverClassName="org.postgresql.Driver"
      url="${DB_URL}" />
</Context>